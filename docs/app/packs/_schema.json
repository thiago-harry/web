{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cronograma-direcionado/pack.schema.json",
  "title": "Content pack - Cronograma Personalizado para Você",
  "type": "object",
  "required": [
    "pack_version",
    "concurso",
    "estrutura_prova",
    "assuntos",
    "provas_historico",
    "nivelamento",
    "notas_banca"
  ],
  "additionalProperties": false,
  "properties": {
    "pack_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "concurso": {
      "type": "object",
      "required": [
        "id",
        "nome",
        "orgao",
        "banca",
        "cargo",
        "data_prova",
        "fonte_edital",
        "curado_em"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "orgao": {
          "type": "string",
          "minLength": 1
        },
        "banca": {
          "type": "string",
          "minLength": 1
        },
        "cargo": {
          "type": "string",
          "minLength": 1
        },
        "data_prova": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fonte_edital": {
          "type": "string"
        },
        "curado_em": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "estrutura_prova": {
      "type": "object",
      "required": [
        "total_questoes",
        "tipo",
        "penalidade_erro",
        "nota_corte_estimada",
        "materias"
      ],
      "additionalProperties": false,
      "properties": {
        "total_questoes": {
          "type": "integer",
          "minimum": 1
        },
        "tipo": {
          "type": "string",
          "enum": [
            "multipla_escolha_4",
            "multipla_escolha_5",
            "certo_errado"
          ]
        },
        "penalidade_erro": {
          "type": "boolean"
        },
        "nota_corte_estimada": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "materias": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "nome",
              "questoes",
              "eliminatoria",
              "min_acertos"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "nome": {
                "type": "string",
                "minLength": 1
              },
              "questoes": {
                "type": "integer",
                "minimum": 0
              },
              "peso": {
                "type": "number",
                "minimum": 0
              },
              "eliminatoria": {
                "type": "boolean"
              },
              "min_acertos": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "assuntos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assunto"
      }
    },
    "provas_historico": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prova_cargo"
      }
    },
    "provas_banca": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prova_banca"
      }
    },
    "nivelamento": {
      "type": "object",
      "required": [
        "modo",
        "itens"
      ],
      "additionalProperties": false,
      "properties": {
        "modo": {
          "type": "string",
          "enum": [
            "autoavaliacao",
            "simulado",
            "hibrido"
          ]
        },
        "itens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item_simulado"
          }
        }
      }
    },
    "notas_banca": {
      "type": "object",
      "required": [
        "estilo",
        "formato_questao",
        "ratio_teoria_questoes_sugerido",
        "recomendacoes_estudo"
      ],
      "additionalProperties": false,
      "properties": {
        "estilo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formato_questao": {
          "type": "string"
        },
        "ratio_teoria_questoes_sugerido": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "recomendacoes_estudo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "assunto": {
      "type": "object",
      "required": [
        "id",
        "materia_id",
        "nome",
        "edital_literal",
        "edital_profundidade",
        "incidencia_cargo",
        "incidencia_banca",
        "carga_horaria_base",
        "prereq",
        "tipo",
        "volatil"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "materia_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "edital_literal": {
          "type": "string"
        },
        "edital_profundidade": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "incidencia_cargo": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ano",
              "questoes"
            ],
            "additionalProperties": false,
            "properties": {
              "ano": {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              "questoes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "incidencia_banca": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "concurso",
              "ano",
              "questoes"
            ],
            "additionalProperties": false,
            "properties": {
              "concurso": {
                "type": "string",
                "minLength": 1
              },
              "ano": {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              "questoes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "carga_horaria_base": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "prereq": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tipo": {
          "type": "string",
          "enum": [
            "lei_seca",
            "doutrina",
            "jurisprudencia",
            "calculo",
            "memorizacao",
            "pratica"
          ]
        },
        "volatil": {
          "type": "boolean"
        },
        "materiais": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/material"
          }
        }
      }
    },
    "prova_cargo": {
      "type": "object",
      "required": [
        "ano",
        "total_questoes",
        "fonte"
      ],
      "additionalProperties": false,
      "properties": {
        "ano": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        },
        "total_questoes": {
          "type": "integer",
          "minimum": 1
        },
        "fonte": {
          "type": "string"
        }
      }
    },
    "prova_banca": {
      "type": "object",
      "required": [
        "concurso",
        "ano",
        "total_questoes",
        "fonte"
      ],
      "additionalProperties": false,
      "properties": {
        "concurso": {
          "type": "string",
          "minLength": 1
        },
        "ano": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        },
        "total_questoes": {
          "type": "integer",
          "minimum": 1
        },
        "fonte": {
          "type": "string"
        }
      }
    },
    "item_simulado": {
      "type": "object",
      "required": [
        "id",
        "assunto_id",
        "enunciado",
        "alternativas",
        "gabarito"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "assunto_id": {
          "type": "string"
        },
        "enunciado": {
          "type": "string",
          "minLength": 1
        },
        "alternativas": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "gabarito": {
          "type": "integer",
          "minimum": 0
        },
        "fonte": {
          "type": "string"
        },
        "ano": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        },
        "desatualizada": {
          "type": "boolean"
        },
        "origem": {
          "type": "string",
          "enum": [
            "prova",
            "gerada_ia"
          ]
        }
      }
    },
    "material": {
      "type": "object",
      "required": [
        "tipo",
        "titulo",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "video",
            "busca_video",
            "leitura",
            "questoes"
          ]
        },
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "canal": {
          "type": "string"
        },
        "duracao_min": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
